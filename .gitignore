# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Data & model artifacts (large; fetched by scripts, never committed).
# Anchored to the repo root so test fixture directories elsewhere are not swallowed.
/data/
/checkpoints/
/runs/
/outputs/
*.tif
*.tiff
*.nc
*.npy
*.npz
*.pt
*.pth
*.safetensors
# Small test fixtures are the exception
!rust/crates/planet-core/tests/data/*.npy
# Released model weights (fp16, ~17 MB each) are tracked so a fresh clone can generate
# planets without retraining. Keep to one file per model name; history grows per update.
!models/*.pt

# OS / editors
.DS_Store
.vscode/
.idea/
